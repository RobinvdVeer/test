# Local development only. Copy to .env and choose strong local values.
TODO_POSTGRES_USER=todouser
TODO_POSTGRES_PASSWORD=change-me-todo-db-password
TODO_POSTGRES_DB=tododb
TODO_DATABASE_URL=postgresql://todouser:change-me-todo-db-password@postgres:5432/tododb

KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=change-me-keycloak-db-password
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
KEYCLOAK_PORT=8080

AUTH_REALM=local-dev
AUTH_CLIENT_ID=todo-app
AUTH_AUDIENCE=todo-app
AUTH_REQUIRED_ROLE=user
AUTH_ISSUER=http://localhost:8080/realms/local-dev
PUBLIC_AUTH_ISSUER=http://localhost:8080/realms/local-dev
AUTH_JWKS_URI=http://keycloak:8080/realms/local-dev/protocol/openid-connect/certs
AUTH_ROLES_CLAIM=realm_access.roles
AUTH_CLIENT_ROLES_CLAIM=resource_access.todo-app.roles
