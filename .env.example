POSTGRES_DB=tododb
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me
APP_BASE_URL=http://localhost:3000
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_POSTGRES_USER=keycloak
